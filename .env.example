# Backend-only Supabase configuration.
# Copy to .env locally, or set these in Replit Secrets / deployment env vars.

# Required for protected write actions on deployed environments.
# Set this in Railway, then enter the same value once in the browser when prompted.
SCHEDULER_ADMIN_TOKEN=<strong-admin-token>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional fallback if you are not using a service-role key.
# SUPABASE_ANON_KEY=<anon-key>

# Google Sheets API access. Prefer a service account in deployed environments;
# share the source spreadsheet with the service account email.
GOOGLE_SERVICE_ACCOUNT_JSON=<google-service-account-json-or-file-path>
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-service-account-json>

# Optional user OAuth fallback. These three values must come from the same
# active OAuth client; stale/deleted OAuth clients fail with invalid_client.
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# GOOGLE_REFRESH_TOKEN=<google-oauth-refresh-token>

# AI provider API key. All AI-powered functions use OpenAI only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AI_REQUEST_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_RETRIES=3

# Google Sheets source of truth. The pipeline reads the Sessions tab through the API.
PIPELINE_SOURCE_URL=https://docs.google.com/spreadsheets/d/16wFlke0bHFcmfn-3UyuYlGnImBq0DY7ouVYAlAFTZys/edit?gid=1313838163#gid=1313838163
